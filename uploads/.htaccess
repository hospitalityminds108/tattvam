# Uploaded files are images and PDFs only. Never run anything from here.
Options -Indexes
<FilesMatch "\.(php\d*|phtml|phar|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
